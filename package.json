{
  "name": "lumen-slides",
  "private": true,
  "version": "1.0.0",
  "description": "Editor de presentaciones HTML de nivel profesional con video de fondo, efectos, animaciones y una API interna para que una IA construya presentaciones.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "mcp": "tsx server/mcp.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cmdk": "^1.1.1",
    "express": "^5.3.0",
    "framer-motion": "^14.9.0",
    "immer": "^11.2.9",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.66.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
